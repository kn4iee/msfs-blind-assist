<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Live probe for the BlueBird 757 tablet, over the Coherent debugger (127.0.0.1:19999): drives BlueBird's EFB agent
    to tap, wheel, read L:vars and mirror. The tablet is read from WASM memory now (not OCR), so the probe no longer
    captures, pops out or parses; it is only the agent commands over the debugger. Not part of the solution; build on
    its own:
      dotnet build tools/Bbs757EfbProbe -c Debug
    See tools/Bbs757EfbProbe/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\MSFSBlindAssist\Resources\coherent-bbs757-efb-agent.js" Link="coherent-bbs757-efb-agent.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
